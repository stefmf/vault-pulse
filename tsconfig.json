{
	"compilerOptions": {
		"baseUrl": "src",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"strict": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"lib": [
			"DOM",
			"ES2018"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"tests/**/*",
		"src/**/*.test.ts",
		"vitest.config.ts"
	]
}
