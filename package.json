{
	"name": "vault-pulse",
	"version": "1.0.0",
	"description": "Show a month calendar and a GitHub-style heatmap of the notes you created and modified each day, from frontmatter dates or file times.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint:obsidian": "eslint . --max-warnings 0",
		"seed": "node scripts/seed-vault.mjs",
		"sync": "node scripts/sync-plugin.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"heatmap",
		"activity",
		"dashboard"
	],
	"author": "Stefmf",
	"license": "MIT",
	"dependencies": {
		"luxon": "^3.4.4"
	},
	"devDependencies": {
		"@types/luxon": "^3.4.2",
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"jsdom": "^24.0.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^1.2.0"
	}
}
